# External macvlan network
NETWORK=services

# Timezone
TZ=Europe/Brussels

# Paths (persistent data lives under /opt/composition/appdata)
DIR_CONFIG=/opt/composition/appdata
DIR_BOOKS=/mnt/wairuha/media/Books

# Grimmory app
APP_USER_ID=0
APP_GROUP_ID=0
GRIMMORY_IP=192.168.1.81
# Port the app actually listens on (used by the healthcheck)
GRIMMORY_PORT=6060

# MariaDB (fill in real secrets here)
DB_USER_ID=1000
DB_GROUP_ID=1000
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=
DB_USER=
DB_PASSWORD=
