# External macvlan network
NETWORK=services

# Timezone
TZ=Europe/Brussels

# Paths (persistent data lives under /opt/composition/appdata)
DIR_CONFIG=/opt/composition/appdata

# User/Group IDs the app runs as (must own DIR_CONFIG/hermes/data)
HERMES_UID=1000
HERMES_GID=1000

# Static IP on the services macvlan network
HERMES_IP=192.168.1.87

# Dashboard basic auth (fill in real secrets here)
HERMES_USR=
HERMES_PWD=

# API server key
API_SERVER_KEY=

# LLM providers (fill in real keys here)
MISTRAL_API_KEY=
DEFAULT_LLM_PROVIDER=mistral-eu
DEFAULT_LLM_MODEL=mistral-small-latest
