# Data directory for NPM (persistent data lives under /opt/composition/appdata)
DATADIR=/opt/composition/appdata/npm

# External macvlan network
NETWORK=services

# Timezone
TZ=Europe/Brussels

# Static IP on the services macvlan network
NETWORK_ADDRESS=192.168.1.84

# NPM API credentials for the docker sync user (fill in real secrets here)
NPM_EMAIL=dockersync@npm.local
NPM_PASSWORD=
