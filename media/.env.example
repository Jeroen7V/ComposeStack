# External macvlan network
NETWORK=services

# Timezone
TIMEZONE=Europe/Brussels

# Paths (persistent data lives under /opt/composition/appdata)
DIR_CONFIG=/opt/composition/appdata
DIR_DOWNLOADS_COMPLETE=/mnt/wairuha/media/Downloads/complete
DIR_DOWNLOADS_INCOMPLETE=/mnt/hdd/incomplete
DIR_FILMS=/mnt/wairuha/media/Videos/Films
DIR_SERIES=/mnt/wairuha/media/Videos/Series
DIR_SPORTS=/mnt/wairuha/media/Videos/Sports
DIR_MUSIC=/mnt/wairuha/media/Music

# Static IPs on the services macvlan network
IP_TRANSMISSION=192.168.1.66
IP_PROWLARR=192.168.1.67
IP_SONARR=192.168.1.68
IP_RADARR=192.168.1.69
IP_BAZARR=192.168.1.70
IP_JELLYFIN=192.168.1.71
IP_TDARR=192.168.1.72
