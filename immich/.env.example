# Network
NETWORK=services
TZ=Europe/Brussels
IMMICH_IP=192.168.1.82

# Paths
UPLOAD_LOCATION=/mnt/wairuha/media/immich
DB_DATA_LOCATION=/opt/composition/appdata/immich/postgres
DIR_CONFIG=/opt/composition/appdata
DIR_PHOTOS_DRIVE=/mnt/wairuha/home/Drive/PhotoBackup
DIR_PHOTOS_HOME=/mnt/wairuha/home/Photos

# The Immich version to use
IMMICH_VERSION=release

# Pinned images (fill in the pinned image:tag@sha256 from the latest immich
# release compose file)
IMAGE_REDIS=
IMAGE_DB=

# Database (fill in real secrets here)
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=
